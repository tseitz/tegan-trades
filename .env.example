# Transcript fetching — optional Webshare rotating residential proxy.
#
# WHY: YouTube IP-blocks the transcript (timedtext) endpoint for
# datacenter/cloud/flagged IPs. Metadata (yt-dlp) still works direct, but
# transcript fetches need a clean residential IP. Set these two vars to route
# ONLY the transcript fetch through Webshare; leave them unset to fetch direct
# (fine from an unblocked IP).
#
# SETUP:
#   1. Buy a "Residential" plan at webshare.io (NOT "Proxy Server"/datacenter).
#      1 GB (~$3.50/mo) covers a full backfill many times over — transcripts
#      are tiny text (~300-400 KB/video through the proxy).
#   2. Copy this file to .env and paste your proxy username/password below.
#   3. Load it before running:  set -a; source .env; set +a
#      (.env is gitignored; never commit real credentials.)

WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=


# Order execution — required only by `setups --execute`.
#
# WHY HERE AND NOT cfg/: cfg/ is committed. Risk settings live in cfg/execution.yaml where
# they can be read in a diff; the signing key lives here, where .gitignore keeps it out of
# the history. execution/config.py has no field that would accept a key from the YAML, so
# the two cannot be confused.
#
# SETUP:
#   1. Go to app.hyperliquid-testnet.xyz (testnet) and connect a wallet.
#   2. Use the faucet to get mock USDC. Nothing here spends real money while
#      cfg/execution.yaml says `network: testnet`.
#   3. More -> API -> generate an API wallet. USE THAT KEY, NOT YOUR MAIN WALLET'S.
#      An API/agent wallet can place and cancel orders but CANNOT WITHDRAW, which is the
#      entire reason to use one. A leaked agent key costs you open positions; a leaked main
#      key costs you the account.
#   4. Load before running:  set -a; source .env; set +a
#
# ACCOUNT_ADDRESS is the account being traded (your wallet address). SECRET_KEY is the API
# wallet's private key — these are two different addresses, and that is expected: the agent
# signs, the account owns.

HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_SECRET_KEY=

# ── Alpaca (US equities, cfg/execution.yaml `venue: alpaca`) ───────────────────
#
# A regulated US broker-dealer, so this is an ordinary brokerage account rather than a
# wallet — funded by ACH from a bank, and crypto cannot fund it. The key pair can place and
# cancel orders but cannot move money out: withdrawals go to a bank on file and are not
# reachable from the trading API, which is the same property that makes a Hyperliquid agent
# wallet the right thing to sign with.
#
#   1. https://app.alpaca.markets/paper/dashboard/overview -> generate a PAPER key.
#   2. Paper and live are different key pairs AND different hosts. A live key will not
#      authenticate against the paper host, which is a feature — the URL is the only thing
#      separating a rehearsal from real money, so it cannot be reached by a wrong flag alone.
#   3. `network: paper` is the default for this venue and `live` needs a typed confirmation.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
