# Machine-generated ore — regenerable, never in git
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Secrets / env — .env is tracked but locked by git-crypt (see .gitattributes)
.env.*
!.env.example
!.env

# OS
.DS_Store

# Editor (machine-specific interpreter paths)
.vscode/
*.code-workspace

# Worktrees (local dev only)
worktrees/

# Node toolchain — web/src/api/schema.d.ts and pnpm-lock.yaml ARE committed, same reason
# uv.lock is: tsc must run without Python, and the lock pins what a fresh clone builds.
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Personal sandbox/permission overrides (machine-specific paths, e.g. ~/vault)
.claude/settings.local.json
# Working plans — ephemeral, not deliverables.
.claude/plans/
